# SvelteKit PHP Adapter local environment template.
#
# Copy values into your shell, CI secret store, or a private local env file.
# Do not commit real hostnames, usernames, remote paths, keys, or tokens.

# Build/runtime base path. Leave empty for root deploys.
SK_BASE_PATH=
DEPLOY_BASE=

# Optional build knobs.
ADAPTER_MODE=php-static
ADAPTER_OUT=build
ADAPTER_ASSETS=build
ADAPTER_BASE_MODE=fixed
ADAPTER_FALLBACK=
PRECOMPRESS=false

# Deployment values. Required only for deploy/publish automation.
# Run `bun run precheck:deploy` before deployment to reject empty,
# placeholder, malformed, or unsafe operational values.
DEPLOY_PROFILE=
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22
DEPLOY_REMOTE=
DEPLOY_LOCAL=./build
DEPLOY_THRESHOLD_FILES=0.35
DEPLOY_THRESHOLD_BYTES=0.5

# Optional post-deploy smoke target. Do not include credentials or query tokens.
ALPHA_SMOKE_BASE_URL=
ALPHA_SMOKE_EXPECTED_VERSION=1.0.0-alpha.1
ALPHA_SMOKE_TIMEOUT_MS=15000
ALPHA_SMOKE_REPORT_PATH=report/alpha-remote-smoke.json
