{
  "name": "sveltekit-php",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev:vite": "vite dev",
    "dev": "node scripts/dev-php.mjs",
    "build": "vite build",
    "serve:php": "php -S 127.0.0.1:8080 -t build router.php",
    "prod": "bun run build:adapter && bun run build && bun run serve:php",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "build:php": "vite build && node scripts/build-php.js",
    "build:apache": "vite build && node scripts/build-apache.js",
    "build:adapter": "bun build adapter/src/index.ts --outfile adapter/index.js --target node --format esm",
    "build:watch": "vite build --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^22",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "tiny-glob": "^0.2.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.6",
    "vite-plugin-devtools-json": "^1.0.0"
  },
  "dependencies": {
    "devalue": "^5.6.1"
  }
}
