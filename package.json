{
  "name": "sveltekit-php",
  "private": false,
  "version": "1.0.2-alpha.0",
  "publishConfig": {
    "tag": "alpha"
  },
  "sveltekitPhpReleasePolicy": {
    "marker": "alpha-over-rc-release-policy",
    "channel": "alpha",
    "track": "1.0.2-alpha",
    "rank": "above-rc",
    "requiredEvidence": [
      "alpha-over-rc-release-policy",
      "native-host-binding-guide",
      "desktop-shell-ui-command-mapping",
      "windows-11-mica-browser-safe-shell",
      "macos-style-native-titlebar-rhythm",
      "alpha-readiness-report-graphics",
      "community-keyword-search-graph",
      "community-analytics-freshness-contract",
      "community-analytics-csv-linkage",
      "router-path-safety-artifact-sync",
      "deploy-env-preflight-safety",
      "hosted-php-smoke-proof"
    ],
    "disallowedDistTags": [
      "latest",
      "rc",
      "stable"
    ]
  },
  "type": "module",
  "exports": {
    ".": "./adapter/index.js",
    "./adapter": "./adapter/index.js"
  },
  "files": [
    "adapter/index.js",
    "README.md",
    "docs/ALPHA-READINESS.md",
    "docs/ALPHA-RELEASE-CHECKLIST.md"
  ],
  "scripts": {
    "dev:vite": "vite dev",
    "dev": "node scripts/dev-php.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "build:php": "vite build && node scripts/build-php.js",
    "build:apache": "vite build && node scripts/build-apache.js",
    "build:adapter": "bun build adapter/src/index.ts --outfile adapter/index.js --target node --format esm",
    "build:e2e": "bun scripts/build-e2e.mjs",
    "build:watch": "vite build --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "bun run verify:all",
    "test:unit": "vitest run --dir tests/unit",
    "test:php": "php -d display_errors=1 tests/unit/redeclare_test.php",
    "test:sanity": "bun scripts/verify-all.mjs --mode=all --skipUnit --skipE2E",
    "test:e2e": "playwright test",
    "test:verify-output": "bun scripts/verify-build-output.mjs",
    "pw": "playwright test",
    "pw:ui": "playwright test --ui",
    "verify": "bun scripts/verify-all.mjs --mode all",
    "verify:build": "node scripts/verify-build-routes.mjs",
    "verify:artifacts": "bun scripts/verify-artifact-sync.mjs",
    "precheck:deploy": "bun scripts/deploy-precheck.mjs",
    "alpha:analytics": "bun scripts/collect-alpha-community-analytics.mjs",
    "alpha:report": "bun scripts/export-alpha-readiness.mjs",
    "alpha:report:full": "bun run alpha:analytics && bun run alpha:remote:placeholder && bun run alpha:report",
    "alpha:consumer:smoke": "bun scripts/smoke-alpha-consumer.mjs",
    "alpha:remote:placeholder": "bun scripts/smoke-remote-alpha.mjs --skip",
    "alpha:remote:smoke": "bun scripts/smoke-remote-alpha.mjs",
    "alpha:gate": "bun scripts/run-alpha-release-gate.mjs",
    "alpha:gate:hosted": "bun scripts/run-hosted-alpha-gate.mjs",
    "verify:alpha": "bun scripts/verify-alpha-readiness.mjs",
    "verify:release-prep": "bun scripts/verify-alpha-release-prep.mjs",
    "verify:php-static": "bun scripts/verify-all.mjs --mode=php-static",
    "verify:js-ssr": "bun scripts/verify-all.mjs --mode=js-ssr",
    "verify:all": "bun scripts/verify-all.mjs --mode=all",
    "verify:output": "bun scripts/verify-build-output.mjs",
    "serve:php": "php -S 127.0.0.1:8080 -t build router.php",
    "serve:e2e": "bun scripts/serve-e2e.mjs"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^22",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "tiny-glob": "^0.2.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.6",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "devalue": "^5.6.1"
  }
}

